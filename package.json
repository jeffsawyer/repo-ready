{
  "name": "@jeffsawyer/repo-ready",
  "version": "0.4.0",
  "description": "Zero-friction release automation setup for JS/TS repos — release-it, changelog, commitlint, lefthook, GitHub Actions, and Slack notifications in one command.",
  "keywords": [
    "release-it",
    "commitlint",
    "lefthook",
    "changelog",
    "semantic-release",
    "github-actions",
    "cli",
    "scaffold",
    "bun",
    "pnpm",
    "prettier",
    "eslint"
  ],
  "author": "Jeff Sawyer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffsawyer/repo-ready.git"
  },
  "type": "module",
  "bin": {
    "repo-ready": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build",
    "release": "LEFTHOOK=0 release-it --ci",
    "prepare": "pnpm exec lefthook install",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "enquirer": "^2.4.1",
    "execa": "^8.0.1",
    "fs-extra": "^11.4.1",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "release-it": "^19.2.4",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.14.0"
}
